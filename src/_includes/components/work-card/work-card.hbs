<a class="work-card" href="{{ localizedUrl book_url @root.lang }}">
  <div class="work-card__media">
    {{#if (lfield book 'cover_image' @root.lang)}}
    <img
      src="{{ lfield book 'cover_image' @root.lang }}"
      alt="{{ lfield book 'title' @root.lang }}"
    />
    {{else}} {{#if (lfield book 'illustration_image' @root.lang)}}
    <img
      src="{{ lfield book 'illustration_image' @root.lang }}"
      alt="{{ lfield book 'title' @root.lang }}"
    />
    {{else}}
    <div class="work-card__fallback">{{> icons/book-open class="icon-md"}}</div>
    {{/if}} {{/if}}
  </div>
  <div class="work-card__header">
    {{#if (lfield book 'title' @root.lang)}}
    <h3>{{ lfield book 'title' @root.lang }}</h3>
    {{else}}
    <p class="work-card__empty">No title available</p>
    {{/if}}
  </div>
</a>
