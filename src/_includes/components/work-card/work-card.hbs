<a class="work-card" href="{{ book_url }}">
  <div class="work-card__media">
    {{#if book.cover_image}}
    <img src="{{ book.cover_image }}" alt="{{ book.title }}" />
    {{else}} {{#if book.illustration_image}}
    <img src="{{ book.illustration_image }}" alt="{{ book.title }}" />
    {{else}}
    <div class="work-card__fallback">{{> icons/book-open class="icon-md"}}</div>
    {{/if}} {{/if}}
  </div>
  <div class="work-card__header">
    {{#if book.title}}
    <h3>{{ book.title }}</h3>
    {{else}}
    <p class="work-card__empty">No title available</p>
    {{/if}}
  </div>
</a>
