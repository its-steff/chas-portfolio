<a class="blog-post-card" href="{{post_url}}">
  <div class="blog-post-card__media">
    {{#if post.hero_image}}
    <img src="{{post.hero_image}}" alt="{{post.title}}" />
    {{/if}}
  </div>

  <div class="blog-post-card__body">
    <div class="blog-post-card__meta">
      <span class="blog-post-card__tag">
        {{> components/badge/badge theme="secondary" text=post.category_tag}}
      </span>
      <span class="blog-post-card__date">
        {{> icons/calendar class="icon-sm"}} {{blogDate post.date "no"}}
      </span>
    </div>

    <h3>{{post.title}}</h3>
    <p>{{post.summary}}</p>

    <span class="blog-post-card__cta">
      <span>{{t "common.read_more" @root.lang @root.i18n}}</span>
      {{> icons/arrow-right class="icon-sm"}}
    </span>
  </div>
</a>
