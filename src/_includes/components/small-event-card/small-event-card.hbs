<a class="small-event-card" href="{{event_url}}">
  <div class="small-event-card__date">
    <span class="small-event-card__day">{{eventDay (lfield event "date" @root.lang) @root.lang}}</span>
    <span class="small-event-card__month">{{eventMonth (lfield event "date" @root.lang) @root.lang}}</span>
  </div>
  <div class="small-event-card__content">
    <h3>{{lfield event "title" @root.lang}}</h3>
    <p>{{lfield event "location" @root.lang}}</p>
  </div>
</a>
