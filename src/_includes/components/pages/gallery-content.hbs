{{#with (localize gallery lang) as |gallery_data|}}
<section class="hero-section">
  <div class="layout-container">
    <div class="gallery-hero">
      <h1>{{ gallery_data.title }}</h1>
      <p>{{ gallery_data.intro }}</p>
    </div>
  </div>
</section> 

<section class="gallery-section">
  <div class="layout-container">
    {{#with (concat (reverse @root.collections.published_books) @root.collections.illustrations) as
    |gallery_items|}}
    <ul class="books-grid books-grid-gallery">
      {{#each gallery_items}}
      <li class="gallery-item {{#if (gt @index 8)}}is-hidden{{/if}}" data-reveal-item="gallery">
        {{> components/work-card/work-card book=this.data book_url=this.url}}
      </li>
      {{/each}}
    </ul>
    {{#if (gt (count gallery_items) 9)}}
    <button
      class="gallery-view-more"
      type="button"
      data-reveal-button="gallery"
      data-reveal-step="3"
    >
      {{t "common.view_more" @root.lang @root.i18n}}
    </button>
    {{/if}} {{/with}}
  </div>
</section>

{{/with}}
