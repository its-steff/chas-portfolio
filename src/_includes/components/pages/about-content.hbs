{{#with (localize about lang) as |about_data|}}
<section class="hero-section about-hero">
  <div class="layout-container">
    <div class="about-hero__grid">
      <div class="about-hero__text">
        <h1>{{ about_data.title }}</h1>
        <p>{{ about_data.intro }}</p>
      </div>
      <div class="about-hero__media">
        <div class="about-hero__glow"></div>
        <div class="about-hero__frame">
          {{#if about_data.hero_image}}
          <img src="{{ about_data.hero_image }}" alt="{{ about_data.title }}" />
          {{else}} {{> icons/user class="hero-fallback-icon"}} {{/if}}
        </div>
      </div>
    </div>
  </div>
</section>

<section class="about-section">
  <div class="layout-container">
    <div class="about-content">{{{ md about_data.body }}}</div>
  </div>
</section>

<section class="skills-section">
  <div class="layout-container">
    <div class="skills-section__text">
      <h2>{{ about_data.skills_title }}</h2>
      <p>{{ about_data.skills_subtext }}</p>
    </div>
    <div class="skills-section__card-container">
      {{#each about_data.skills_list}}
      <div class="skills-section__card">
        {{> icons{{ this.icon_name }} class="skills-section__icon" }}
        <h3>{{ this.skill.name }}</h3>
        <spa>{{this.skill.description}}</spa>
      </div>
      {{/each}}
    </div>
  </div>
</section>

{{/with}}
