{{#with (localize contact lang) as |contact_data|}}
<section class="hero-section">
  <div class="layout-container">
    <div class="hero-content">
      {{#if contact_data.title}}
      <h1>{{contact_data.title}}</h1>
      {{/if}} {{#if contact_data.subtext}}
      <p>{{contact_data.subtext}}</p>
      {{/if}}
    </div>
  </div>
</section>

<section class="information-section">
  <div class="layout-container">
    <div class="card-container">
      <div class="card">
        <span> {{> icons/mail class="icon-lg logo-mark"}} {{contact_data.email_title}}</span>
        <a href="mailto:{{contact_data.email_address}}"> {{contact_data.email_address}}</a>
      </div>

      <div class="card">
        <span>{{> icons/globe class="icon-lg logo-mark"}} {{contact_data.location_title}}</span>
        <p>{{contact_data.location_text}}</p>
      </div>

      <div class="card">
        <span>{{> icons/scroll class="icon-lg logo-mark"}} {{contact_data.information_title}}</span>
        <p>{{contact_data.information_text}}</p>
      </div>
    </div>
  </div>
</section>

<section class="faq-section">
  <div class="layout-container">
    <div class="faq-content">
      <h2>{{contact_data.faq_title}}</h2>
      {{#if contact_data.faqs}}
      <div class="faq-card">
        <div class="faq-accordion" data-accordion="single">
          {{#each contact_data.faqs}}
          <div class="faq-item" data-accordion-item>
            <button
              class="faq-trigger"
              type="button"
              id="faq-trigger-{{@index}}"
              aria-controls="faq-panel-{{@index}}"
              aria-expanded="false"
            >
              <span>{{this.question}}</span>
              {{> icons/chevron-down class="faq-icon"}}
            </button>
            <div
              class="faq-panel"
              id="faq-panel-{{@index}}"
              role="region"
              aria-labelledby="faq-trigger-{{@index}}"
              aria-hidden="true"
            >
              <div class="faq-panel__inner">{{{ md this.answer }}}</div>
            </div>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}
    </div>
  </div>
</section>
{{/with}}
