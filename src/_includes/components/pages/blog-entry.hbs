---
layout: layouts/base.hbs
page_class: blog-entry-page
---

{{#if hero_image}}
<section class="blog-entry-hero-media">
  <img src="{{hero_image}}" alt="{{title}}" />
  <div class="blog-entry-hero-overlay"></div>
</section>
{{/if}}

<article class="blog-entry-article">
  <div class="layout-container">
    <div class="blog-entry-shell">
      <a class="blog-entry-back" href="/no/blogg/">
        {{> icons/arrow-left class="icon-sm"}} Tilbake til blogg
      </a>

      <header class="blog-entry-header">
        {{#if category_tag}} {{> components/badge/badge theme="secondary" text=category_tag}}
        {{/if}}

        <h1>{{title}}</h1>
        {{#if summary}}
        <p class="blog-entry-summary">{{summary}}</p>
        {{/if}}

        <div class="blog-entry-meta">
          <span>{{> icons/calendar class="icon-sm"}} {{blogDate date "no"}}</span>
        </div>
      </header>

      <div class="blog-entry-body">{{{content}}}</div>
    </div>
  </div>
</article>
