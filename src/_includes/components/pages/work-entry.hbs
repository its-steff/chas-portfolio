---
layout: layouts/base.hbs
page_class: work-entry
---

<section class="hero-section">
  <div class="layout-container">
    <div class="hero-content">
      <h1>{{ localize title lang }}</h1>
      <h2>{{ localize subtitle lang }}</h2>
      {{#if (localize summary lang)}}
      <p>{{ localize summary lang }}</p>
      {{/if}}
    </div>
    {{> components/decorative-divider/decorative-divider}}
  </div>
</section>

<section class="image-section">
  <div class="layout-container">
    <div class="work-entry-image-shell">
      <div class="work-entry-image-frame">
        {{#if (localize cover_image lang)}}
        <img src="{{ localize cover_image lang }}" alt="{{ localize title lang }}" />
        {{else}} {{#if (localize illustration_image lang)}}
        <img src="{{ localize illustration_image lang }}" alt="{{ localize title lang }}" />
        {{/if}} {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="about-section">
  <div class="layout-container">
    {{#if (localize body lang)}} {{> components/about-card/about-card body=(localize body lang)}}
    {{else}} {{> components/about-card/about-card body=content}} {{/if}}
  </div>
</section>
