---
layout: layouts/base.hbs
page_class: work-entry
---

<section class="hero-section">
  <div class="layout-container">
    <div class="hero-content">
      <h1>{{ lfield this 'title' lang }}</h1>
      <h2>{{ lfield this 'subtitle' lang }}</h2>
      {{#if (lfield this 'summary' lang)}}
      <p>{{ lfield this 'summary' lang }}</p>
      {{/if}}
    </div>
    {{> components/decorative-divider/decorative-divider}}
  </div>
</section>

<section class="image-section">
  <div class="layout-container">
    <div class="work-entry-image-shell">
      <div class="work-entry-image-frame">
        {{#if (lfield this 'cover_image' lang)}}
        <img src="{{ lfield this 'cover_image' lang }}" alt="{{ lfield this 'title' lang }}" />
        {{else}} {{#if (lfield this 'illustration_image' lang)}}
        <img
          src="{{ lfield this 'illustration_image' lang }}"
          alt="{{ lfield this 'title' lang }}"
        />
        {{/if}} {{/if}}
      </div>
    </div>
  </div>
</section>

<section class="about-section">
  <div class="layout-container">
    {{#if (lfield this 'body' lang)}} {{> components/about-card/about-card body=(lfield this 'body'
    lang)}} {{else}} {{> components/about-card/about-card body=content}} {{/if}}
  </div>
</section>
